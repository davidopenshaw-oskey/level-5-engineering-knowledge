{
  "repositories": [
    {
      "name": "firebase-oskey-dev",
      "gitUrl": "git@github.com:oskey-io/firebase-oskey-dev.git",
      "branch": "master",
      "modulesRoot": "functions/src/modules",

      "tsconfigRelativePath": "functions/tsconfig.json",

      "astErrorTolerancePercent": 0,

      "governancePath": "governance/reference-docs",

      "classificationRules": {
        "serviceSuffixes": ["Service", "Publisher", "Processor"],
        "controllerSuffixes": ["Controller", "Handler"]
      },

      "normalizationRules": {
        "stripPrefixes": ["OSK"],
        "stripServiceSuffixes": ["Service"],
        "stripControllerSuffixes": ["Controller"],
        "serviceClassSuffixes": ["Service", "Publisher", "Processor"]
      }
    }
  ]
}
